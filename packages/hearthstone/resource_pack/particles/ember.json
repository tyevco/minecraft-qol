{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "hearthstone:ember",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/ember"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 3 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.1 },
      "minecraft:emitter_shape_box": {
        "offset": [0, 0, 0],
        "half_dimensions": [0.22, 0.05, 0.22],
        "direction": [0, 1, 0]
      },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "math.random(0.8, 1.6)" },
      "minecraft:particle_initial_speed": "math.random(0.4, 0.9)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 0.6, 0],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [0.07, 0.07],
        "facing_camera_mode": "lookat_xyz",
        "uv": { "texture_width": 8, "texture_height": 8, "uv": [0, 0], "uv_size": [8, 8] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": { "0.0": "#FFFFF1B5", "0.5": "#FFE27928", "1.0": "#0096421E" },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
