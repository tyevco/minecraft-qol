{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "graves:wisp",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/wisp"
      }
    },
    "components": {
      "minecraft:emitter_local_space": { "position": true, "rotation": true },
      "minecraft:emitter_rate_steady": { "spawn_rate": 1.5, "max_particles": 6 },
      "minecraft:emitter_lifetime_looping": { "active_time": 1 },
      "minecraft:emitter_shape_box": {
        "offset": [0, 0, 0],
        "half_dimensions": [0.2, 0.1, 0.15],
        "direction": [0, 1, 0]
      },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "math.random(2.0, 3.0)" },
      "minecraft:particle_initial_speed": "math.random(0.1, 0.25)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 0.05, 0],
        "linear_drag_coefficient": 0.3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [0.09, 0.09],
        "facing_camera_mode": "lookat_xyz",
        "uv": { "texture_width": 8, "texture_height": 8, "uv": [0, 0], "uv_size": [8, 8] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": { "0.0": "#00F2FBFF", "0.3": "#FFF2FBFF", "1.0": "#007FC8FF" },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
