  "settings": [
    {
      "type": "label",
      "text": "What happens to a player's items when they die, by permission role. §7Off§r: items drop where they died (vanilla). §7Gravestone§r: items wait in a gravestone where they died; interact with it to take them back. §7Keep§r: items stay in their inventory."
    },
    {
      "type": "dropdown",
      "text": "Visitors",
      "name": "graves:visitors",
      "options": [
        { "name": "off", "text": "Off" },
        { "name": "grave", "text": "Gravestone" },
        { "name": "keep", "text": "Keep" }
      ],
      "default": "keep"
    },
    {
      "type": "dropdown",
      "text": "Members",
      "name": "graves:members",
      "options": [
        { "name": "off", "text": "Off" },
        { "name": "grave", "text": "Gravestone" },
        { "name": "keep", "text": "Keep" }
      ],
      "default": "grave"
    },
    {
      "type": "dropdown",
      "text": "Operators",
      "name": "graves:operators",
      "options": [
        { "name": "off", "text": "Off" },
        { "name": "grave", "text": "Gravestone" },
        { "name": "keep", "text": "Keep" }
      ],
      "default": "off"
    },
    {
      "type": "toggle",
      "text": "Tell a player where their gravestone is",
      "name": "graves:announce",
      "default": true
    },
    {
      "type": "toggle",
      "text": "Anyone can open any gravestone",
      "name": "graves:public",
      "default": false
    }
  ]
