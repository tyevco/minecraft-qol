PROJECT_NAME="qol_times"

# MINECRAFT_PRODUCT: BedrockGDK | PreviewGDK | Custom
#
# BedrockGDK resolves to:
#   %APPDATA%\Minecraft Bedrock\Users\Shared\games\com.mojang
# On machines migrated from the old UWP build that path is a DANGLING SYMLINK
# pointing at %LOCALAPPDATA%\Packages\Microsoft.MinecraftUWP_*\LocalState\games\com.mojang,
# which no longer exists. Check before trusting it:
#   ls "$APPDATA/Minecraft Bedrock/Users/Shared/games/com.mojang"
#
# If it is broken, use Custom and point at your own per-user (XUID) folder.
# Forward slashes on purpose: dotenv treats backslashes in double-quoted values
# as escape sequences.
MINECRAFT_PRODUCT="Custom"
CUSTOM_DEPLOYMENT_PATH="C:/Users/<you>/AppData/Roaming/Minecraft Bedrock/Users/<XUID>/games/com.mojang"
