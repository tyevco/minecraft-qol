  "settings": [
    {
      "type": "label",
      "text": "An egg hatches after it has been warmed enough times: coal for an ember egg, bone meal for moss, a snowball for frost. Each warming is followed by a rest."
    },
    {
      "type": "slider",
      "text": "Warmings to hatch",
      "name": "hatchling:warmings",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "slider",
      "text": "Rest between warmings (minutes)",
      "name": "hatchling:warm_cooldown",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 10
    },
    {
      "type": "label",
      "text": "A hatchling bonds with the first player to feed it sweet berries, then grows through two more sizes as it is fed. Each feeding is followed by a rest."
    },
    {
      "type": "slider",
      "text": "Feedings per growth stage",
      "name": "hatchling:feedings",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "slider",
      "text": "Rest between feedings (minutes)",
      "name": "hatchling:feed_cooldown",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 15
    },
    {
      "type": "toggle",
      "text": "Anyone can warm eggs and feed hatchlings, not only the owner",
      "name": "hatchling:anyone_tends",
      "default": true
    }
  ]
}
