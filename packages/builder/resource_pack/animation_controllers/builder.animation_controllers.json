{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.builder_person.general": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "work": "query.property('builder:working')"
            },
            {
              "walk": "query.modified_move_speed > 0.05"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "idle": "query.modified_move_speed <= 0.05"
            }
          ],
          "blend_transition": 0.2
        },
        "work": {
          "animations": [
            "idle",
            "work"
          ],
          "transitions": [
            {
              "idle": "!query.property('builder:working')"
            }
          ]
        }
      }
    }
  }
}
