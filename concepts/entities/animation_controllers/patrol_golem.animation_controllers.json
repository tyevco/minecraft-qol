{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.concept_patrol_golem.general": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "attack": "variable.attack_time > 0"
            },
            {
              "walk": "query.modified_move_speed > 0.05"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "attack": "variable.attack_time > 0"
            },
            {
              "idle": "query.modified_move_speed <= 0.05"
            }
          ],
          "blend_transition": 0.2
        },
        "attack": {
          "animations": [
            "walk",
            "attack"
          ],
          "transitions": [
            {
              "idle": "query.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}
