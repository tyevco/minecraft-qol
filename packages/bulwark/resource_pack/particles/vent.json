{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bulwark:vent",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/vent"
      }
    },
    "components": {
      "minecraft:emitter_local_space": { "position": true, "rotation": true },
      "minecraft:emitter_rate_steady": { "spawn_rate": 2, "max_particles": 8 },
