  "settings": [
    {
      "type": "label",
      "text": "How much of the damage a player would take actually lands, by permission role. Guardian only ever reduces damage: a role at §7100%§r plays vanilla and is never touched."
    },
    {
      "type": "dropdown",
      "text": "Visitors take",
      "name": "guardian:visitors",
      "options": [
        {
          "name": "100",
          "text": "100% (vanilla)"
        },
        {
          "name": "75",
          "text": "75%"
        },
        {
          "name": "50",
          "text": "50%"
        },
        {
          "name": "25",
          "text": "25%"
        },
        {
          "name": "0",
          "text": "No damage"
        }
      ],
      "default": "25"
    },
    {
      "type": "dropdown",
      "text": "Members take",
      "name": "guardian:members",
      "options": [
        {
          "name": "100",
          "text": "100% (vanilla)"
        },
        {
          "name": "75",
          "text": "75%"
        },
        {
          "name": "50",
          "text": "50%"
        },
        {
          "name": "25",
          "text": "25%"
        },
        {
          "name": "0",
          "text": "No damage"
        }
      ],
      "default": "50"
    },
    {
      "type": "dropdown",
      "text": "Operators take",
      "name": "guardian:operators",
      "options": [
        {
          "name": "100",
          "text": "100% (vanilla)"
        },
        {
          "name": "75",
          "text": "75%"
        },
        {
          "name": "50",
          "text": "50%"
        },
        {
          "name": "25",
          "text": "25%"
        },
        {
          "name": "0",
          "text": "No damage"
        }
      ],
      "default": "100"
    },
    {
      "type": "label",
      "text": "Safety switches for §7Visitors and Members§r. Each one removes a whole kind of damage, whatever the percentage above says. Operators are never affected by these."
    },
    {
      "type": "toggle",
      "text": "No fall damage",
      "name": "guardian:no_fall",
      "default": true
    },
    {
      "type": "toggle",
      "text": "No fire, lava or magma damage",
      "name": "guardian:no_burn",
      "default": true
    },
    {
      "type": "toggle",
      "text": "No drowning",
      "name": "guardian:no_drown",
      "default": false
    },
    {
      "type": "toggle",
      "text": "Void catch: a player who falls out of the world is put back where they last stood",
      "name": "guardian:void_catch",
      "default": true
    },
    {
      "type": "toggle",
      "text": "Tell a player when Guardian softened a hit",
      "name": "guardian:announce",
      "default": false
    }
