{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.villages_person": {
      "arrays": {
        "geometries": {
          "Array.people": [
            "Geometry.stonefolk",
            "Geometry.reedfolk",
            "Geometry.tinker",
            "Geometry.tallfolk",
            "Geometry.hobbit",
            "Geometry.wood_elf",
            "Geometry.high_elf",
            "Geometry.drow"
          ]
        },
        "textures": {
          "Array.look": [
            "Texture.stonefolk_guard",
            "Texture.stonefolk_worker",
            "Texture.stonefolk_trader",
            "Texture.stonefolk_builder",
            "Texture.reedfolk_guard",
            "Texture.reedfolk_worker",
            "Texture.reedfolk_trader",
            "Texture.reedfolk_builder",
            "Texture.tinker_guard",
            "Texture.tinker_worker",
            "Texture.tinker_trader",
            "Texture.tinker_builder",
            "Texture.tallfolk_guard",
            "Texture.tallfolk_worker",
            "Texture.tallfolk_trader",
            "Texture.tallfolk_builder",
            "Texture.hobbit_guard",
            "Texture.hobbit_worker",
            "Texture.hobbit_trader",
            "Texture.hobbit_builder",
            "Texture.wood_elf_guard",
            "Texture.wood_elf_worker",
            "Texture.wood_elf_trader",
            "Texture.wood_elf_builder",
            "Texture.high_elf_guard",
            "Texture.high_elf_worker",
            "Texture.high_elf_trader",
            "Texture.high_elf_builder",
            "Texture.drow_guard",
            "Texture.drow_worker",
            "Texture.drow_trader",
            "Texture.drow_builder"
          ]
        }
      },
      "geometry": "Array.people[math.clamp(q.property('villages:people'), 0, 7)]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.look[math.clamp(q.property('villages:people'), 0, 7) * 4 + math.clamp(q.property('villages:job'), 0, 3)]"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "helmet": "q.property('villages:job') == 0"
        },
        {
          "hat": "q.property('villages:job') == 1 || q.property('villages:people') >= 5"
        },
        {
          "pack": "q.property('villages:job') >= 2"
        },
        {
          "tool": "q.property('villages:job') == 3"
        }
      ]
    }
  }
}
