PROJECT_NAME="qol_times"

# MINECRAFT_PRODUCT: BedrockGDK | PreviewGDK | Custom
#
# Development packs load from the SHARED folder, not the per-user (XUID) one:
#   %APPDATA%\Minecraft Bedrock\Users\Shared\games\com.mojang\development_behavior_packs
# Confirmed empirically - packs placed only in the per-user folder were never
# listed in game, and appeared as soon as the shared path was populated.
#
# BedrockGDK points at that shared path already, so it SHOULD just work. The
# catch: on machines migrated from the old UWP build, Users\Shared\games\com.mojang
# is a symlink into %LOCALAPPDATA%\Packages\Microsoft.MinecraftUWP_*\LocalState\games\com.mojang,
# and a reinstall can delete that target - leaving a dangling link and packs that
# silently never load. Check yours:
#
#   ls "$APPDATA/Minecraft Bedrock/Users/Shared/games/com.mojang"
#
# If that errors, recreate the directory the symlink points to (do not replace
# the symlink - worlds and options resolve through the per-user folder and you
# do not want to disturb them).
#
# We use Custom pointed at the shared path so the deploy target is explicit
# rather than inferred. Forward slashes on purpose: dotenv treats backslashes in
# double-quoted values as escape sequences.
MINECRAFT_PRODUCT="Custom"
CUSTOM_DEPLOYMENT_PATH="C:/Users/<you>/AppData/Roaming/Minecraft Bedrock/Users/Shared/games/com.mojang"
