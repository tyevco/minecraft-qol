{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmit": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@qol/shared/*": ["packages/shared/*"]
    }
  },
  "include": ["packages/**/*.ts", "tools/**/*.ts"],
  "exclude": ["node_modules", "dist", "lib", "packages/probe"]
}
