{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.concept_decoy.general": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "hit": "query.hurt_time > 0"
            }
          ]
        },
        "hit": {
          "animations": [
            "idle",
            "hit"
          ],
          "transitions": [
            {
              "idle": "query.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}
