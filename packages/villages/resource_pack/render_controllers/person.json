{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.villages_person": {
      "arrays": {
        "geometries": {
          "Array.people": [
            "Geometry.stonefolk",
            "Geometry.reedfolk",
            "Geometry.tinker",
            "Geometry.tallfolk",
            "Geometry.hobbit",
            "Geometry.wood_elf",
            "Geometry.high_elf",
            "Geometry.drow",
            "Geometry.drover",
            "Geometry.foxfolk",
            "Geometry.catfolk",
            "Geometry.wolffolk",
            "Geometry.rabbitfolk",
            "Geometry.bearfolk",
            "Geometry.fennecfolk",
            "Geometry.mousefolk",
            "Geometry.squirrelfolk",
            "Geometry.otterfolk",
            "Geometry.deerfolk"
          ]
        },
        "textures": {
          "Array.look": [
            "Texture.stonefolk_guard",
            "Texture.stonefolk_worker",
            "Texture.stonefolk_trader",
            "Texture.stonefolk_builder",
            "Texture.reedfolk_guard",
            "Texture.reedfolk_worker",
            "Texture.reedfolk_trader",
            "Texture.reedfolk_builder",
            "Texture.tinker_guard",
            "Texture.tinker_worker",
            "Texture.tinker_trader",
            "Texture.tinker_builder",
            "Texture.tallfolk_guard",
            "Texture.tallfolk_worker",
            "Texture.tallfolk_trader",
            "Texture.tallfolk_builder",
            "Texture.hobbit_guard",
            "Texture.hobbit_worker",
            "Texture.hobbit_trader",
            "Texture.hobbit_builder",
            "Texture.wood_elf_guard",
            "Texture.wood_elf_worker",
            "Texture.wood_elf_trader",
            "Texture.wood_elf_builder",
            "Texture.high_elf_guard",
            "Texture.high_elf_worker",
            "Texture.high_elf_trader",
            "Texture.high_elf_builder",
            "Texture.drow_guard",
            "Texture.drow_worker",
            "Texture.drow_trader",
            "Texture.drow_builder",
            "Texture.drover_guard",
            "Texture.drover_worker",
            "Texture.drover_trader",
            "Texture.drover_builder",
            "Texture.foxfolk_guard",
            "Texture.foxfolk_worker",
            "Texture.foxfolk_trader",
            "Texture.foxfolk_builder",
            "Texture.catfolk_guard",
            "Texture.catfolk_worker",
            "Texture.catfolk_trader",
            "Texture.catfolk_builder",
            "Texture.wolffolk_guard",
            "Texture.wolffolk_worker",
            "Texture.wolffolk_trader",
            "Texture.wolffolk_builder",
            "Texture.rabbitfolk_guard",
            "Texture.rabbitfolk_worker",
            "Texture.rabbitfolk_trader",
            "Texture.rabbitfolk_builder",
            "Texture.bearfolk_guard",
            "Texture.bearfolk_worker",
            "Texture.bearfolk_trader",
            "Texture.bearfolk_builder",
            "Texture.fennecfolk_guard",
            "Texture.fennecfolk_worker",
            "Texture.fennecfolk_trader",
            "Texture.fennecfolk_builder",
            "Texture.mousefolk_guard",
            "Texture.mousefolk_worker",
            "Texture.mousefolk_trader",
            "Texture.mousefolk_builder",
            "Texture.squirrelfolk_guard",
            "Texture.squirrelfolk_worker",
            "Texture.squirrelfolk_trader",
            "Texture.squirrelfolk_builder",
            "Texture.otterfolk_guard",
            "Texture.otterfolk_worker",
            "Texture.otterfolk_trader",
            "Texture.otterfolk_builder",
            "Texture.deerfolk_guard",
            "Texture.deerfolk_worker",
            "Texture.deerfolk_trader",
            "Texture.deerfolk_builder"
          ]
        }
      },
      "geometry": "Array.people[math.clamp(q.property('villages:people'), 0, 18)]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.look[math.clamp(q.property('villages:people'), 0, 18) * 4 + math.clamp(q.property('villages:job'), 0, 3)]"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "helmet": "q.property('villages:job') == 0"
        },
        {
          "hat": "q.property('villages:job') == 1 || (q.property('villages:people') >= 5 && q.property('villages:people') <= 7) || (q.property('villages:people') == 8 && q.property('villages:job') != 0)"
        },
        {
          "pack": "q.property('villages:job') >= 2"
        },
        {
          "tool": "q.property('villages:job') == 3"
        }
      ]
    }
  }
}
