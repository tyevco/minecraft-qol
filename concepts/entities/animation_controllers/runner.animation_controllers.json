{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.concept_runner.general": {
      "initial_state": "hover",
      "states": {
        "hover": {
          "animations": [
            "hover"
          ],
          "transitions": [
            {
              "deliver": "query.property('concept:delivering')"
            },
            {
              "dart": "query.modified_move_speed > 0.05"
            }
          ]
        },
        "dart": {
          "animations": [
            "hover",
            "dart"
          ],
          "transitions": [
            {
              "hover": "query.modified_move_speed <= 0.05"
            }
          ],
          "blend_transition": 0.15
        },
        "deliver": {
          "animations": [
            "hover",
            "deliver"
          ],
          "transitions": [
            {
              "hover": "query.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}
